# ─────────────────────────────────────────────────────────────
#  .env.example — Copy this file to .env and fill in real values
#  NEVER commit your real .env file to Git!
# ─────────────────────────────────────────────────────────────

# ─── Database ──────────────────────────────────────────────────
# For Render: paste the "External Database URL" from your Render PostgreSQL dashboard
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Redis ─────────────────────────────────────────────────────
# For Upstash: paste the "Redis URL" from your Upstash dashboard
# Format: rediss://default:password@host:port  (note: rediss:// for TLS)
REDIS_URL=rediss://default:your_password@your-upstash-host.upstash.io:6379

# ─── API Security ──────────────────────────────────────────────
# Generate a strong random key: openssl rand -hex 32
API_KEY=your_secure_api_key_here

# ─── CORS ──────────────────────────────────────────────────────
# Set to your Render service URL after first deploy, e.g.:
# CORS_ORIGINS=https://your-app-name.onrender.com
# Leave blank to allow all origins during initial setup
CORS_ORIGINS=

# ─── Scraper Settings ──────────────────────────────────────────
REMOTEIO_API_BASE=https://remote.io/api/v2/jobs
JOBS_PER_PAGE=30
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Optional: rotating proxy URL to prevent IP bans (leave blank if none)
# Example: http://user:pass@gate.smartproxy.com:7000
PROXY_URL=

# ─── Scheduler ─────────────────────────────────────────────────
SCRAPE_INTERVAL_HOURS=1

# ─── App ───────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ─── CSV Export Path ───────────────────────────────────────────
CSV_EXPORT_PATH=exports/jobs_export.csv

# ─── Apollo.io Enrichment ──────────────────────────────────────
# Get your API key from https://developer.apollo.io
APOLLO_API_KEY=your_apollo_api_key_here
